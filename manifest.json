{
  "manifest_version": 3,
  "name": "Essence Extractor",
  "version": "1.0.1",
  "description": "Extract content 'Essence' from the current page.",
  "action": {
    "default_title": "Run Essence"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["essence.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "256": "icons/Icon256.png",
    "128": "icons/Icon128.png",
    "32": "icons/Icon32.png",
    "16": "icons/Icon16.png"
  }
}
